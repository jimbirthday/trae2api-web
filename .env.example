# API Key（Bearer 鉴权 + 面板登录口令）。changeme 是占位符，请换成你自己的随机密钥。
TW2A_API_KEY=changeme

# ===== 必读：TRAE 网页登录回调（两种方式二选一）=====
# A. 生产推荐：配公网基址，回调链接 = <该值>/authorize，反代把 /authorize 转到容器 8000
# TW2A_PUBLIC_BASE_URL=https://trae.example.com
# B. 本机调试：映射回调端口，回调链接用宿主机可达地址（不要用 127.0.0.1，除非同机）
# TW2A_CALLBACK_PORT=18080
# TW2A_CALLBACK_PUBLISH=18080
# 回调 server 绑定地址：容器内必须 0.0.0.0，绑 127.0.0.1 外部进不来
# TW2A_CALLBACK_BIND=0.0.0.0

# 仅 docker compose 使用：宿主暴露端口（容器内恒为 8000）
# TW2A_PORT=8000

# ===== 可选覆盖（留空则用 config.json / 内置默认）=====
# TW2A_LISTEN=:8000
# TW2A_DEFAULT_MODEL=glm-5.2
# TW2A_TIMEOUT_SECONDS=120
# TW2A_CORS_ORIGINS=https://a.example.com,https://b.example.com
# 模型别名（客户端模型名=上游模型名，逗号分隔，只做一级映射）
# TW2A_MODEL_ALIASES=gpt-4o=glm-5.2,fast=kimi-k3
#
# 账号池
# TW2A_MAX_IN_FLIGHT=2
# TW2A_CREDIT_FLOOR=0
# TW2A_SOFT_RATE=60s
# TW2A_SOFT_RATE_MAX=30m
# TW2A_ERR_THRESHOLD=3
# TW2A_ERR_COOLDOWN=10m
# TW2A_BREAKER_THRESHOLD=3
# TW2A_BREAKER_COOLDOWN=10m
# TW2A_BREAKER_COOLDOWN_MAX=1h
# TW2A_DEGRADE_THRESHOLD=5
# TW2A_DEGRADE_WINDOW=10m
# TW2A_PLAN_CREDIT=12h
#
# 会话粘性
# TW2A_SESSION_ENABLED=true
# TW2A_SESSION_TTL=30m
# TW2A_SESSION_GC_INTERVAL=5m
#
# 请求流水 / 用量
# TW2A_REQLOG_ENABLED=true
# TW2A_REQLOG_DIR=./data/logs
# TW2A_REQLOG_FILE_MAX_MB=16
# TW2A_REQLOG_RETAIN_DAYS=3
# TW2A_USAGE_ENABLED=true
# TW2A_USAGE_FILE=./data/usage.json
# TW2A_CREDIT_SAMPLING=30s
#
# 定时任务（整点，多值用逗号分隔）
# TW2A_CHECKIN_HOUR=9
# TW2A_SCHEDULE_REFRESH_HOURS=3
# TW2A_SCHEDULE_BALANCE_HOURS=8,12,18,23
# 定时任务对上游的并发上限（1..32）。账号多时串行会跑很久且无法及时响应 SIGTERM。
TW2A_SCHEDULE_CONCURRENCY=4
#
# 思考内容呈现方式：reasoning（默认，走 delta.reasoning_content）
#                   / content（包进 think 标签当正文发，空档期立刻有字）
#                   / none（丢弃思考）
# TW2A_STREAM_THINKING=reasoning
# 空闲保活间隔（上游静默时写 SSE 注释，防代理掐断）；0/off = 关闭
# TW2A_STREAM_HEARTBEAT=1s
